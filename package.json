{
  "name": "@scshafe/ui",
  "version": "0.3.1",
  "description": "The SCSHAFE standard frontend library: framework-light React components, layout primitives and a token-driven stylesheet, with optional state, icon, identity, build and testing subpaths.",
  "type": "module",
  "license": "MIT",
  "author": "scshafe-ui contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/scshafe/scshafe-ui.git"
  },
  "bugs": {
    "url": "https://github.com/scshafe/scshafe-ui/issues"
  },
  "homepage": "https://github.com/scshafe/scshafe-ui#readme",
  "keywords": [
    "react",
    "components",
    "design-tokens",
    "ui"
  ],
  "engines": {
    "node": ">=22.22.0 <23 || >=24.18.0 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./state": {
      "types": "./lib/state/index.d.ts",
      "default": "./lib/state/index.js"
    },
    "./icons": {
      "types": "./lib/icons/index.d.ts",
      "default": "./lib/icons/index.js"
    },
    "./identity": {
      "types": "./lib/identity/index.d.ts",
      "default": "./lib/identity/index.js"
    },
    "./editor": {
      "types": "./lib/editor/index.d.ts",
      "default": "./lib/editor/index.js"
    },
    "./build": {
      "types": "./lib/build.d.ts",
      "default": "./lib/build.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./tokens": {
      "types": "./lib/tokens.d.ts",
      "default": "./lib/tokens.js"
    },
    "./layout.css": "./layout.css",
    "./components.css": "./components.css",
    "./tokens.css": "./tokens.css",
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "layout.css",
    "components.css",
    "tokens.css",
    "docs/FRONTEND-DOCTRINE.md",
    "docs/ACCESSIBILITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "test:payload": "node scripts/check-package-payload.mjs",
    "test:release-artifact": "node scripts/check-release-artifact.mjs",
    "test:install": "node scripts/check-pack-install.mjs",
    "test:fresh-clone": "node scripts/check-fresh-clone.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:payload && pnpm run test:release-artifact && pnpm run test:install",
    "verify": "pnpm run clean && pnpm run check",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify",
    "release:manifest": "node scripts/write-release-manifest.mjs"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": ">=2",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "esbuild": ">=0.20",
    "iconoir-react": ">=7",
    "react": ">=18",
    "react-dom": ">=18",
    "react-redux": ">=9",
    "tiptap-markdown": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "@reduxjs/toolkit": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "iconoir-react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-redux": {
      "optional": true
    },
    "tiptap-markdown": {
      "optional": true
    }
  },
  "devDependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "iconoir-react": "7.12.1",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "tiptap-markdown": "0.9.0",
    "typescript": "5.8.3"
  }
}
