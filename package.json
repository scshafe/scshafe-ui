{
  "name": "@scshafe/ui",
  "version": "0.2.0",
  "description": "The SCSHAFE standard frontend library: framework-light React components, layout primitives and a token-driven stylesheet, with optional state, icon, identity, build and testing subpaths.",
  "type": "module",
  "license": "MIT",
  "author": "scshafe-ui contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/scshafe/scshafe-ui.git"
  },
  "bugs": {
    "url": "https://github.com/scshafe/scshafe-ui/issues"
  },
  "homepage": "https://github.com/scshafe/scshafe-ui#readme",
  "keywords": [
    "react",
    "components",
    "design-tokens",
    "ui"
  ],
  "engines": {
    "node": ">=22.22.0 <23 || >=24.18.0 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./state": {
      "types": "./lib/state/index.d.ts",
      "default": "./lib/state/index.js"
    },
    "./icons": {
      "types": "./lib/icons/index.d.ts",
      "default": "./lib/icons/index.js"
    },
    "./identity": {
      "types": "./lib/identity/index.d.ts",
      "default": "./lib/identity/index.js"
    },
    "./build": {
      "types": "./lib/build.d.ts",
      "default": "./lib/build.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./layout.css": "./layout.css",
    "./components.css": "./components.css",
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "layout.css",
    "components.css",
    "README.md",
    "docs"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test": "node --test --test-force-exit test/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "@reduxjs/toolkit": ">=2",
    "react-redux": ">=9",
    "esbuild": ">=0.20",
    "iconoir-react": ">=7"
  },
  "peerDependenciesMeta": {
    "@reduxjs/toolkit": {
      "optional": true
    },
    "react-redux": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "iconoir-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@tiptap/core": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "typescript": "5.8.3",
    "@types/node": "^22.0.0",
    "iconoir-react": "^7.11.0"
  }
}
